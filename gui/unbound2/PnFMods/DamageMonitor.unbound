(def constant DMonitor_INFLICTED_DAMAGE_COMPONENT_KEY 'modDamageMonitorInflictedKey')
(def constant DMonitor_RECEIVD_DAMAGE_COMPONENT_KEY 'modDamageMonitorReceivedKey')
(def constant DMonitor_TARGET_COMPONENT_KEY 'modDamageMonitorTargetKey')
(def constant DMonitor_TEAM_TOTAL_DAMAGE_COMPONENT_KEY 'modDamageMonitorTeamTotalDamageKey')

(def constant DMonitor_DAMAGE_WIDTH 50px)
(def constant DMonitor_ROW_HEIGHT 15px)

(def constant DMonitor_ANIM_DURATION 0.6)

(def constant DMonitor_SHIP_ICON_COLOR_PRESETS [
	#Use -(234-0x??)
	#None
	{
		Auxiliary:	{},
		AirCarrier:	{},
		Battleship:	{},
		Cruiser:	{},
		Destroyer: 	{},
		Submarine:	{},
	},
	#Aslain v1
	{
		Auxiliary:	{redOffset: -184, greenOffset: -134, blueOffset: -234, alphaOffset:    0},
		AirCarrier:	{redOffset: -106, greenOffset:  -64, blueOffset:   21, alphaOffset:    0},
		Battleship:	{redOffset:   21, greenOffset: -106, blueOffset: -106, alphaOffset:    0},
		Cruiser:	{redOffset:	  21, greenOffset: 	  0, blueOffset: -106, alphaOffset:    0},
		Destroyer: 	{redOffset:	 -64, greenOffset: 	 21, blueOffset: -106, alphaOffset:    0},
		Submarine:	{redOffset: -207, greenOffset:    4, blueOffset:   11, alphaOffset:    0},
	},
	#Aslain v2
	{
		Auxiliary:	{redOffset: -184, greenOffset: -134, blueOffset: -234, alphaOffset:    0},
		AirCarrier:	{redOffset:  -43, greenOffset: -106, blueOffset:   21, alphaOffset:    0},
		Battleship:	{redOffset:   21, greenOffset: -106, blueOffset: -106, alphaOffset:    0},
		Cruiser:	{redOffset:	  21, greenOffset: 	  0, blueOffset: -106, alphaOffset:    0},
		Destroyer: 	{redOffset:	 -64, greenOffset: 	 21, blueOffset: -106, alphaOffset:    0},
		Submarine:	{redOffset: -106, greenOffset:  -64, blueOffset:   21, alphaOffset:    0},
	},
	#AutoSpy
	{
		Auxiliary:	{redOffset: -184, greenOffset: -134, blueOffset: -234, alphaOffset: -128},
		AirCarrier:	{redOffset: -134, greenOffset: -134, blueOffset: -134, alphaOffset: -128},
		Battleship:	{redOffset: -234, greenOffset: -184, blueOffset: -154, alphaOffset: -128},
		Cruiser:	{redOffset: -89,  greenOffset: -159, blueOffset: -234, alphaOffset: -128},
		Destroyer: 	{redOffset: -184, greenOffset: -134, blueOffset: -184, alphaOffset: -128},
		Submarine:	{redOffset: -224, greenOffset: -224, blueOffset: -224, alphaOffset: -128},
	},
	#Roslich
	{
		Auxiliary:	{redOffset:   21, greenOffset: -234, blueOffset:   21, alphaOffset:    0},
		AirCarrier:	{redOffset:   21, greenOffset:   21, blueOffset: -234, alphaOffset:    0},
		Battleship:	{redOffset:   21, greenOffset: -234, blueOffset: -234, alphaOffset:    0},
		Cruiser:	{redOffset: -234, greenOffset: -234, blueOffset:   21, alphaOffset:    0},
		Destroyer: 	{redOffset: -234, greenOffset:    0, blueOffset: -234, alphaOffset:    0},
		Submarine:	{redOffset: -234, greenOffset:   21, blueOffset:   21, alphaOffset:    0},
	},
	#DeCease
	{
		Auxiliary:	{redOffset:   11, greenOffset: -235, blueOffset:   40, alphaOffset:    0},
		AirCarrier:	{redOffset:   -9, greenOffset:  -60, blueOffset: -119, alphaOffset:    0},
		Battleship:	{redOffset:  -65, greenOffset:  -74, blueOffset:   40, alphaOffset:    0},
		Cruiser:	{redOffset:   20, greenOffset:  -76, blueOffset: -128, alphaOffset:    0},
		Destroyer: 	{redOffset: -137, greenOffset:   11, blueOffset: -124, alphaOffset:    0},
		Submarine:	{redOffset: -255, greenOffset: -255, blueOffset: -255, alphaOffset:    0},
	},
	#Hakabase
	{
		Auxiliary:	{redOffset: -184, greenOffset: -134, blueOffset: -234, alphaOffset:  -70},
		AirCarrier:	{redOffset: -226, greenOffset:   -7, blueOffset:   21, alphaOffset:  -70},
		Battleship:	{redOffset:   21, greenOffset: -234, blueOffset: -234, alphaOffset:  -70},
		Cruiser:	{redOffset:	  21, greenOffset: 	 21, blueOffset: -234, alphaOffset:  -70},
		Destroyer: 	{redOffset:	-234, greenOffset: 	 21, blueOffset: -234, alphaOffset:  -70},
		Submarine:	{redOffset:   21, greenOffset: -234, blueOffset:  -81, alphaOffset:  -70},
	},
])

(def element DMonitor_DamageMonitor() layout=true
	(scope
		(macro STAGE_SIZE)

        (macro IS_SPECTATOR_MODE)

        # Target Entity
        (var targetEntityWatcher:gfx = "$datahub.getPrimWatcher(CC.mods_DataComponent, DMonitor_TARGET_COMPONENT_KEY)")
		(var targetEntity:gfx = "targetEntityWatcher.entity" (event "targetEntityWatcher.event"))
		(var targetDataComponent:gfx = "targetEntity ? targetEntity.mods_DataComponent : null")
		(var targetData:dict = "targetDataComponent ? targetDataComponent.data : null" (event "targetDataComponent.evDataChanged"))
		(var targetId:str = "targetData && targetData['avatarId'] ? toString(targetData.avatarId) : null")
        # 'avatarId' in targetData ? targetData.avatarId : ''
        #
        # Using an empty string causes the following error:
        #   `String '' is not a valid number`
        # Yeah of course that's the whole point of STRING. WHY IS IT TRYING TO CONVERT IT TO STRING?!
        #
        # Maybe, the type cast also occurs inside of the expression, in addition to the final variable update.
        # e.g. If the type of `targetData.avatarId` is number, and then gets replaced by the '',
        # the expression tries to convert '' into number because the value in the same position was internally number type?

        (var playerAvatar:gfx = "$datahub.getSingleEntity(CC.playerAvatar)")
        (var ownId:str = "playerAvatar ? playerAvatar.avatar.id : ''")

        (macro TT_GET_PREF _varName="'hideOthersPref'" _key="'dMonitor.hideOthers'")
        (var isOnlyOwnDamageVisible:bool = "null != hideOthersPref && null != hideOthersPref.value ? hideOthersPref.value : false")
        (var targetAvatarId:str = "isOnlyOwnDamageVisible && !isSpectatorTrainingMode ? ownId : targetId")
	)

    (style
		(bind width "stageWidth")
		(bind height "stageHeight")
	)

    (element DMonitor_DetailedDamageElement _targetAvatarId="targetAvatarId")
)

(def element DMonitor_DetailedDamageElement(_targetAvatarId:str)
    (scope
        # Python owns the position value, its resKey bucket AND the first-placement default
        # (dMonitor.position's center/bottom anchor, which the pivot below matches), so there is no
        # view-side default or stage math here.
        (macro TT_DRAGGABLE_POSITION _fullKey="'dMonitor.position'")

        (macro TT_GET_PREF _varName="'uiScalePref'" _key="'dMonitor.appearance.uiScale'")
        (var scale:number = "null != uiScalePref && null != uiScalePref.value ? uiScalePref.value : 1")
        (macro TT_GET_PREF _varName="'backgroundAlphaPref'" _key="'dMonitor.background.alpha'")
        (var backgroundAlpha:number = "null != backgroundAlphaPref && null != backgroundAlphaPref.value ? backgroundAlphaPref.value : 0.4")
        (macro TT_GET_PREF _varName="'disableDragdropPref'" _key="'dMonitor.disableDragdrop'")
        (var isPositionLocked:bool = "null != disableDragdropPref && null != disableDragdropPref.value ? disableDragdropPref.value : false")

        # Expand
        (event evExpandButtonClicked)
        (macro TT_GET_PREF _varName="'displayModePref'" _key="'dMonitor.displayMode'")
        (var displayMode:number = "null != displayModePref && null != displayModePref.value ? displayModePref.value : TT_CONST.DISPLAY_MODE.ENABLED")

        (var camera:gfx = "$datahub.getSingleComponent(CC.camera)")
		(var altVision:bool = "camera.altVision" (event "camera.evAltVisionChanged"))
        (var isExpanded:bool = "displayMode == TT_CONST.DISPLAY_MODE.ADAPTIVE ? altVision : displayMode")
        # The button writes DISABLED/ENABLED, never ADAPTIVE -- an explicit click leaves the
        # alt-vision mode rather than cycling inside it.
        (bindcall externalCall 'direct.action' "['mod.setPref', ['dMonitor.displayMode', isExpanded ? TT_CONST.DISPLAY_MODE.DISABLED : TT_CONST.DISPLAY_MODE.ENABLED]]" init=false watch=false (event "evExpandButtonClicked"))
    )
    (style
        (position = "absolute")
        (bind left "dragX")
        (bind top "dragY")
        # NO pivot -- top-left origin, as legacy.  A stored position is an ORIGIN, so a pivot change
        # re-reads the folded legacy damageMonitor_positionX/Y at a different corner and shifts every
        # migrated panel by (w/2, h).
        # The schema's center/bottom anchor does NOT need a matching pivot: Python resolves defaults
        # size-aware and the pivot cancels (boxLeft = P - f*size, via the reported pox/poy), so the
        # panel's centre/bottom edge lands where the anchor says either way.  Matching only avoids a
        # one-frame offset before the first reportGeometry, for a user with no stored position.
        (align = "middle|center")
    )

    # Drag surface -- full-size over this element, which is what Python is told about (reportGeometry
    # describes the block TT_DRAGGABLE sits in, so a small grab handle would relocate the panel).
    # Declared FIRST so the injected signifier stays behind the content (zindex does not cross a block
    # boundary) and so the buttons above keep their own hit-testing.
    (block
        (class $FullsizeAbsolute)
        (style
            (backgroundColor = 0x00FFFFFF)
            # hitTest is a STYLE property when BOUND -- directly under a (block ...) it throws at build
            # time. Dropping it when locked is also what suppresses the drag-hint tooltip; the macro
            # only gates the writes and the signifier.
            (bind hitTest "!isPositionLocked")
        )
        (macro TT_DRAGGABLE _fullKey="'dMonitor.position'" _isDragEnabled="!isPositionLocked")
    )

    # Expand button
    (element DMonitor_ButtonExpand
        _expanded="isExpanded"

        (style
            (left = -24px)
            (top = 5px)
            (position = "absolute")
            (hitTest = true)
        )
    )
    # Setting
    (element TT_ConfigButtonElement _modSlug = "'damage-monitor'"
        (style
            (left = -30px)
            (top = 20px)
        )
    )

    (block
        (style
            (bind scaleX "scale")
            (bind scaleY "scale")
        )

        (mc contrast_panel
            (class $FullsizeAbsolute)
            (style
                (bind alpha "backgroundAlpha")
                (hitTest = false)
            )
        )

        (element DMonitor_DamagePanelElement
            _targetAvatarId="_targetAvatarId"

            (bind visible "isExpanded")
        )
    )
)

(def element DMonitor_DamagePanelElement(_targetAvatarId:str)
    (scope
        (macro TT_GET_PREF _varName="'clanNamePref'" _key="'dMonitor.playerInfo.clanName'")
        (var isClanTagVisible:bool = "null != clanNamePref && null != clanNamePref.value ? clanNamePref.value : true")

        # Avatar
        (var avatarEntity:gfx = "$datahub.getPrimaryEntity(CC.avatar, _targetAvatarId)")
        (var avatarComponent:gfx = "avatarEntity ? avatarEntity.avatar : null")
        (var playerName:str = "avatarComponent ? (isClanTagVisible ? avatarComponent.name : avatarComponent.pureName) : ''")
        (var ship:gfx = "avatarComponent ? avatarComponent.ship.ref.ship : null")
        (var shipName:str = "avatarComponent ? tr(ship.nameIDS) : ''")
		(var shipType:str = "avatarComponent ? ship.subtype : ''")
        (var shipIcon:str = "'url:../battle_hud/markers/ship/icon_white_' + toLower(shipType) + '.png'")
    )

    (style
        (align = "middle|center")
    )

    (hblock
        (style
            (align = "middle|center")
            (marginTop = 6px)
            (marginBottom = 6px)
            (hitTest = false)
        )

        (element DMonitor_HeaderTextItem _text="playerName")

        (element DMonitor_ShipIconItem _shipType="shipType" _iconDir=1)

        (element DMonitor_HeaderTextItem _text="shipName")
    )


    (element DMonitor_DamageTableElement
        _targetAvatarId="_targetAvatarId"
    )
)

(def element DMonitor_DamageTableElement(_targetAvatarId:str)
    (scope
        # Received Damage Data Entity
		(var rDamageEntityWatcher:gfx = "$datahub.getPrimWatcher(CC.mods_DataComponent, DMonitor_RECEIVD_DAMAGE_COMPONENT_KEY)")
		(var rDamageEntity:gfx = "rDamageEntityWatcher.entity" (event "rDamageEntityWatcher.event"))

		(var rDamageDataComponent:gfx = "rDamageEntity ? rDamageEntity.mods_DataComponent : null")
		(var receivedDamageData:dict = "rDamageDataComponent ? rDamageDataComponent.data : {}" (event "rDamageDataComponent.evDataChanged"))
        (var receivedDamage:dict = "_targetAvatarId in receivedDamageData ? receivedDamageData[_targetAvatarId] : {}")

        # Inflicted Damage Data Entity
        (var iDamageEntityWatcher:gfx = "$datahub.getPrimWatcher(CC.mods_DataComponent, DMonitor_INFLICTED_DAMAGE_COMPONENT_KEY)")
		(var iDamageEntity:gfx = "iDamageEntityWatcher.entity" (event "iDamageEntityWatcher.event"))

		(var iDamageDataComponent:gfx = "iDamageEntity ? iDamageEntity.mods_DataComponent : null")
		(var inflictedDamageData:dict = "iDamageDataComponent ? iDamageDataComponent.data : {}" (event "iDamageDataComponent.evDataChanged"))
        (var inflictedDamage:dict = "_targetAvatarId in inflictedDamageData ? inflictedDamageData[_targetAvatarId] : {}")

        # Team Total Damage
        (var tDamageEntityWatcher:gfx = "$datahub.getPrimWatcher(CC.mods_DataComponent, DMonitor_TEAM_TOTAL_DAMAGE_COMPONENT_KEY)")
		(var tDamageEntity:gfx = "tDamageEntityWatcher.entity" (event "tDamageEntityWatcher.event"))

		(var tDamageDataComponent:gfx = "tDamageEntity ? tDamageEntity.mods_DataComponent : null")
		(var teamDamageData:dict = "tDamageDataComponent ? tDamageDataComponent.data : {}" (event "tDamageDataComponent.evDataChanged"))

        # Prefs
        (macro TT_GET_PREF _varName="'receivedVisiblePref'" _key="'dMonitor.receivedDamageVisible'")
        (var isReceivedDamageVisible:bool = "null != receivedVisiblePref && null != receivedVisiblePref.value ? receivedVisiblePref.value : true")
        (macro TT_GET_PREF _varName="'inflictedVisiblePref'" _key="'dMonitor.inflictedDamageVisible'")
        (var isInflictedDamageVisible:bool = "null != inflictedVisiblePref && null != inflictedVisiblePref.value ? inflictedVisiblePref.value : true")
    )

    (style
        (hitTest = false)
    )

    (block
        (style
            (flow = "Flow.HORIZONTAL")
            (align = "middle|center")
            (paddingLeft = 10px)
            (paddingRight = 10px)
            (paddingBottom = 10px)
        )
        (block
            # Enclose Instance controller to keep the elements in order after disable/enabled
            (controller $Instance renderer='DMonitor_DamageListElement'
                (bind enabled "isReceivedDamageVisible")
                (args
                    _targetAvatarId="_targetAvatarId"
                    _damageData="receivedDamage"
                    _teamDamageData="teamDamageData"
                    _isInflictedDamage = "false"
                )
            )
        )
        (element VerticalDivider
            (bind visible "isReceivedDamageVisible && isInflictedDamageVisible")
        )
        (block
            (controller $Instance renderer='DMonitor_DamageListElement'
                (bind enabled "isInflictedDamageVisible")
                (args
                    _targetAvatarId="_targetAvatarId"
                    _damageData="inflictedDamage"
                    _teamDamageData="teamDamageData"
                    _isInflictedDamage = "true"
                )
            )
        )
    )
)

(def element DMonitor_DamageListElement(_targetAvatarId:str, _damageData:dict, _teamDamageData:dict, _isInflictedDamage:bool=true)
    (scope
        (macro TT_GET_PREF _varName="'rowCountsPref'" _key="'dMonitor.appearance.rowCounts'")
        (var rowCounts:number = "null != rowCountsPref && null != rowCountsPref.value ? rowCountsPref.value : 4")

        (var collection:gfx = "$datahub.getCollection(CC.avatar)")
		(var allyCollection:gfx = "collection.getChildByPath('team.ally.sortedLeftTeam')")
        (var numAllies:number = "allyCollection.items.length" (event "allyCollection.evAdded"))

        (var idsKey:str = "_isInflictedDamage ? 'victimIds' : 'attackerIds'")
        (var playerIds:array = "idsKey in _damageData ? _damageData[idsKey] : []")
        (var idsLength:number = "playerIds.length")

        (var titleLabel:str = "_isInflictedDamage ? 'IDS_BATTLE_STATS_CAUSED_DAMAGE' : 'IDS_TAKEN_DAMAGE_HINT'")

        # Avatar
        (var avatarEntity:gfx = "$datahub.getPrimaryEntity(CC.avatar, _targetAvatarId)")

        # Relation
        (var relationComponent:gfx = "avatarEntity && avatarEntity.hasComponent(CC.relation) ? avatarEntity.relation : null" (event "avatarEntity.evAdded"))
        (var relationValue:number = "relationComponent ? relationComponent.value : 0" (event "relationComponent.evChanged"))
		(var isAlly:bool = "relationComponent && relationValue == SC.Battle.PLAYER_RELATION.ALLY")
        (var isSelf:bool = "relationComponent && relationValue == SC.Battle.PLAYER_RELATION.SELF")

        # CT
        (var relationName:str = "_isInflictedDamage ?
                                        isSelf  ? 'self' :
                                        isAlly  ? 'ally'
                                                : 'enemy'
                                :
                                        isAlly || isSelf    ? 'enemy'
                                                            : 'ally'"
        )

        (macro TT_GET_PREF _varName="'barAlphaPref'" _key="'dMonitor.appearance.barAlpha'")
        (var barAlpha:number = "null != barAlphaPref && null != barAlphaPref.value ? barAlphaPref.value : 0.7")
        (var baseCT:dict = "TWO_TEAMS_COLOR_TRANSFORMS[relationName]")
        (var markerColorTransform:dict = "{redOffset: baseCT.redOffset, greenOffset: baseCT.greenOffset, blueOffset: baseCT.blueOffset, alphaMultiplier: barAlpha}")
    )

    (style
        (align = "middle|center")
    )

    (element DMonitor_DamageHeaderElement
        _damageData="_damageData"
        _teamDamageData="_teamDamageData"
        _colorTransform="markerColorTransform"
        _isInflictedDamage="_isInflictedDamage"
    )

    (element HorizontalDividerTwoPx)

    (block
        (controller $Repeat
            (renderer = 'DMonitor_DamageRowElement')
            (bind count "rowCounts")
            (args
                _playerId = "$index < idsLength ? playerIds[$index] : ''"
                _damageData = "_damageData"
                _teamDamageData = "_teamDamageData"
                _colorTransform = "markerColorTransform"
                _isInflictedDamage = "_isInflictedDamage"
            )
        )
    )
)

(def element DMonitor_DamageHeaderElement(_damageData:dict, _teamDamageData:dict, _colorTransform:dict, _isInflictedDamage:bool=true)
    (scope
        (event evShow)

        (macro DMonitor_GET_COLUMN_PREFS)

        (var totalWidth:number = "(playerInfoWidth * isPlayerNameVisible) + (shipInfoWidth * isShipNameVisible) + DMonitor_DAMAGE_WIDTH + (SHIP_ICON_SIZE.WIDTH * isShipTypeVisible)")

        (var titleLabel:str = "_isInflictedDamage ? 'IDS_BATTLE_STATS_CAUSED_DAMAGE' : 'IDS_TAKEN_DAMAGE_HINT'")

        (var totalDamage:number = "'totalDamage' in _damageData ? floor(_damageData.totalDamage) : 0")
        (var scaleBase:number = "'personalDamageScaleBase' in _teamDamageData ? _teamDamageData.personalDamageScaleBase : 50000")
        (var scaleDirection:number = "_isInflictedDamage ? 1 : -1")

        (var flowDirection:number = "_isInflictedDamage ? Flow.REVERSE_HORIZONTAL : Flow.HORIZONTAL")

        (var animatedDamage:number = "0" watch=false)
        (controller $Animation
            # Increasing damage
			(bindcall play	duration = "DMonitor_ANIM_DURATION"
							to = "{ animatedDamage: totalDamage}"
							easing="Easing.cubic_out"
                            watch=false
                            action="killAll"
							(bind trigger "totalDamage")
                            (bind enabled "totalDamage > animatedDamage")
							(event "evShow")
			)
            # Decreasing: changed target
            (bindcall play	duration = "DMonitor_ANIM_DURATION"
                            from = "{ animatedDamage: 0}"
							to = "{ animatedDamage: totalDamage}"
							easing="Easing.cubic_out"
                            watch=false
                            action="killAll"
							(bind trigger "totalDamage")
                            (bind enabled "totalDamage < animatedDamage")
							(event "evShow")

			)
		)
        (var barScale:number = "scaleDirection * animatedDamage / scaleBase")
    )

    (dispatch evShow on='addedToStage')

    (style
        (align = "middle|center")
        (bind width "totalWidth")
    )

    (block
        (class $FullsizeAbsolute)
        (style
            (bind backgroundColor "0xFFFFFFFF")
            (backgroundSize = "fill")
            (bind scaleX "barScale")
            (bind left "_isInflictedDamage ? 0% : 100%")
        )

        (bind colorTransform "_colorTransform")
    )

    (element DMonitor_HeaderTextItem _text="tr(titleLabel)"
        (style
            (marginTop = 5px)
        )
    )

    (element DMonitor_HeaderTextItem _text="ceil(animatedDamage)"
        (style
            (marginBottom = 5px)
        )
    )

)

(def element DMonitor_DamageRowElement(_playerId:str, _damageData:dict, _teamDamageData:dict, _colorTransform:dict, _isInflictedDamage:bool=true)
    (scope
        (event evShow)
        #
        (macro DMonitor_GET_COLUMN_PREFS)

        (macro TT_GET_PREF _varName="'rowHeightPref'" _key="'dMonitor.appearance.rowHeight'")
        (var rowHeightOffset:number = "null != rowHeightPref && null != rowHeightPref.value ? rowHeightPref.value : 5")
        (macro TT_GET_PREF _varName="'clanNamePref'" _key="'dMonitor.playerInfo.clanName'")
        (var isClanTagVisible:bool = "null != clanNamePref && null != clanNamePref.value ? clanNamePref.value : true")

        (var isDataAvailable:bool = "_playerId != ''")

        # Avatar
        (var avatarEntity:gfx = "$datahub.getPrimaryEntity(CC.avatar, _playerId)")
        (var avatarComponent:gfx = "avatarEntity ? avatarEntity.avatar : null")
        (var playerName:str = "avatarComponent ? (isClanTagVisible ? avatarComponent.name : avatarComponent.pureName) : ''")
        (var ship:gfx = "avatarComponent ? avatarComponent.ship.ref.ship : null")
        (var shipName:str = "avatarComponent ? tr(ship.nameIDS) : ''")
		(var shipType:str = "avatarComponent ? ship.subtype : ''")

        (var damage:number = "_playerId in _damageData ? floor(_damageData[_playerId]) : 0")

        # Style
        (var nameAlign:number = "_isInflictedDamage ? right : left")
        (var elementAlign:number = "_isInflictedDamage ? middle|left : middle|right")
        (var flowDirection:number = "_isInflictedDamage ? Flow.REVERSE_HORIZONTAL : Flow.HORIZONTAL")
        (var scaleDirection:number = "_isInflictedDamage ? 1 : -1")

        (var scaleBase:number = "'personalDamageScaleBase' in _teamDamageData ? _teamDamageData.personalDamageScaleBase : 50000")

        (var animatedDamage:number = "0" watch=false)
        (controller $Animation
            # Increasing damage
			(bindcall play	duration = "DMonitor_ANIM_DURATION"
							to = "{ animatedDamage: damage}"
							easing="Easing.cubic_out"
                            watch=false
                            action="killAll"
							(bind trigger "damage")
                            (bind enabled "damage > animatedDamage")
							(event "evShow")
			)
            # Decreasing: changed target
            (bindcall play	duration = "DMonitor_ANIM_DURATION"
                            from = "{ animatedDamage: 0}"
							to = "{ animatedDamage: damage}"
							easing="Easing.cubic_out"
                            watch=false
                            action="killAll"
							(bind trigger "damage")
                            (bind enabled "damage < animatedDamage")
							(event "evShow")

			)
		)
        (var barScale:number = "scaleDirection * animatedDamage / scaleBase")
    )

    (dispatch evShow on='addedToStage')

    (block

        (style
            (bind flow "flowDirection")
            (bind height "DMonitor_ROW_HEIGHT + rowHeightOffset")
            (align = "middle|center")
            (bind alpha "isDataAvailable")
        )

        # HP Bar
        (block
            (class $FullsizeAbsolute)
            (style
                (bind backgroundColor "0xFFFFFFFF")
                (backgroundSize = "fill")
                (bind scaleX "barScale")
                (bind left "_isInflictedDamage ? 0% : 100%")
            )

            (bind colorTransform "_colorTransform")
        )

        # Player Name
        (block
            (controller $Instance renderer='DMonitor_TextItem'
                (bind enabled "isPlayerNameVisible")
                (args
                    _text="playerName" _width="playerInfoWidth" _textAlign="nameAlign"
                )
            )
        )

        # Ship Icon
        (block
            (controller $Instance renderer='DMonitor_ShipIconItem'
                (bind enabled "isShipTypeVisible")
                (args
                    _shipType="shipType"
                    _iconDir="scaleDirection"
                )
            )
        )

        # Ship Name
        (block
            (controller $Instance renderer='DMonitor_TextItem'
                (bind enabled "isShipNameVisible")
                (args
                    _text="shipName" _width="shipInfoWidth"  _textAlign="nameAlign"
                )
            )
        )

        # Damage
        (element DMonitor_TextItem _text="ceil(animatedDamage)" _width="DMonitor_DAMAGE_WIDTH" _textAlign="center")
    )
    (element HorizontalDividerTwoPx)
)

(def element DMonitor_ShipIconItem (_shipType:str, _iconDir:number)
    (scope
        (macro TT_GET_PREF _varName="'classIconStylePref'" _key="'dMonitor.shipInfo.color'")
        (var shipTypeStylePrefIndex:number = "null != classIconStylePref && null != classIconStylePref.value ? classIconStylePref.value : 0")

        (var shipTypeStyleIndex:number = "shipTypeStylePrefIndex < DMonitor_SHIP_ICON_COLOR_PRESETS.length ? shipTypeStylePrefIndex : 0")
		(var shipTypeStyle:dict = "DMonitor_SHIP_ICON_COLOR_PRESETS[shipTypeStyleIndex]")
        (var shipTypeCT:dict = "_shipType in shipTypeStyle ? shipTypeStyle[_shipType] : {}")

        (var shipIcon:str = "'url:../battle_hud/markers/ship/icon_white_' + toLower(_shipType) + '.png'")
    )

    (style
        (width = "SHIP_ICON_SIZE.WIDTH")
        (height = "SHIP_ICON_SIZE.HEIGHT")
        (pivotX = 50%)
        (bind scaleX "_iconDir")
    )
    (block
        # For better edge for colored icons
        (style
            (bind backgroundImage "shipIcon")
        )
    )
    (block
        (style
            (bind backgroundImage "shipIcon")
        )
        (bind colorTransform "shipTypeCT")
    )
)

(def css $DMonitor_DefaultText()
	(extends $TextDefault)
	(extends $FontEnableReadability)
)

(def css $DMonitor_DefaultBoldText()
	(extends $TextDefaultBold)
	(extends $FontEnableReadability)
)

(def css $DMonitor_HeaderText()
	(extends $TextDefaultBold17NM)
	(extends $FontEnableReadability)
)

(def element DMonitor_TextItem(_text:str, _isBold:bool=false, _width:number="'auto'", _textAlign:number = "left")
	(scope
        (macro DMonitor_GET_FONT_COLOR)
        (var fontClass:str = "_isBold ? '$DMonitor_DefaultBoldText' : '$DMonitor_DefaultText' ")
	)

	(style
		(bind width "_width")
	)

	(tf
		(bind class "fontClass")
		(style
			(bind width "_width")
			(bind textAlign "_textAlign")
			(bind textColor "fontColor")
			(elideMode = "true")
		)
		(bind text "_text")
	)
)

(def element DMonitor_HeaderTextItem(_text:str, _width:number="'auto'", _textAlign:number = "left")
	(scope
        (macro DMonitor_GET_FONT_COLOR)
	)

	(style
        (marginTop = 3px)
        (marginBottom = 3px)
		(bind width "_width")
	)

	(tf
		(class $DMonitor_HeaderText)
		(style
			(bind width "_width")
			(bind textAlign "_textAlign")
            (bind textColor "fontColor")
			(elideMode = "true")
		)
		(bind text "_text")
	)
)

(def element DMonitor_ButtonExpand (_isInOverState:bool=false, _isInDownState:bool=false, _expanded:bool=false, _enabled:bool=true) layout=true
	(scope
		(event evExpandButtonClicked)
		(event btnExpand_evMouseUp)

		(macro MOUSE_HANDLER_SCOPE "'btnExpand_'")

		(var isInOverState:bool = "_isInOverState || btnExpand_rollOver && !btnExpand_mouseDown")
		(var isInDownState:bool = "_isInDownState || btnExpand_rollOver && btnExpand_mouseDown")

		(var targetAlpha:number = "	isInDownState	? 0.6 :
									isInOverState	? 1
													: 0.75")
		(var targetRotation:number = "_expanded ? 90 : 0")
	)

	(macro MOUSE_HANDLER
		_enabled = "_enabled"
		_prefix = "'btnExpand_'"
		_soundSet = "'dropdown'"
	)
	(dispatch btnExpand_evMouseUp on='mouseUp' args="{isDown: false}" (bind enabled "_enabled"))
	(dispatch evExpandButtonClicked args={} watch=false init=false dir="EventDirection.UP" (event "btnExpand_evMouseUp"))

	(style
		(width = 13px)
		(height = 13px)
		(align = "center|middle")
	)

	(alpha = "targetAlpha")

	(controller $Animation
		(bindcall play	duration=0.07	to="{alpha: targetAlpha}"	(bind trigger "targetAlpha"))
	)

	(block
		(style
			(hitTest = "false")
			(backgroundSize = "autosize")
			(backgroundImage = "'url:../service_kit/buttons/expand_over.png'")

			(pivotX = 50%)
			(pivotY = 50%)
			(left = 0%)
			(right = 0%)
			(rotation = "targetRotation")
		)

		(controller $Animation
			(bindcall play	duration=0.15	to="{rotation: targetRotation}"	(bind trigger "targetRotation"))
		)
	)
)

# The font colour is one packed ARGB `color` setting now (it was a palette ORDINAL into
# DMonitor_FONT_COLORS, and the CMS paletteIndex migration decodes stored ordinals through that same
# palette -- so the palette constant is dead, not renamed).  textColor is an ARGB target, so `value`
# binds straight through; never recompute a packed colour in the view (>= 2^31 overflows).
(def macro DMonitor_GET_FONT_COLOR ()
    (macro TT_GET_PREF _varName="'__fontColorPref'" _key="'dMonitor.appearance.fontColor'")
    (var fontColor:number = "null != __fontColorPref && null != __fontColorPref.value ? __fontColorPref.value : 0xFFEEEEEE")
)

# The five column prefs the header row and the data rows both need, folded so a silently-wrong key has
# one place to live instead of two.  Fixed var names (the TT_GET_LANGUAGE_INDEX pattern) -- one use per
# scope.
(def macro DMonitor_GET_COLUMN_PREFS ()
    (macro TT_GET_PREF _varName="'__playerWidthPref'" _key="'dMonitor.playerInfo.width'")
    (var playerInfoWidth:number = "__playerWidthPref.value")
    (macro TT_GET_PREF _varName="'__shipWidthPref'" _key="'dMonitor.shipInfo.width'")
    (var shipInfoWidth:number = "__shipWidthPref.value")
    (macro TT_GET_PREF _varName="'__playerNamePref'" _key="'dMonitor.playerInfo.playerName'")
    (var isPlayerNameVisible:bool = "null != __playerNamePref && null != __playerNamePref.value ? __playerNamePref.value : true")
    (macro TT_GET_PREF _varName="'__shipNamePref'" _key="'dMonitor.shipInfo.name'")
    (var isShipNameVisible:bool = "null != __shipNamePref && null != __shipNamePref.value ? __shipNamePref.value : true")
    (macro TT_GET_PREF _varName="'__classIconPref'" _key="'dMonitor.shipInfo.icon'")
    (var isShipTypeVisible:bool = "null != __classIconPref && null != __classIconPref.value ? __classIconPref.value : true")
)

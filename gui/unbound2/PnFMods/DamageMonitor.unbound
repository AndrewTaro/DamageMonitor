(def constant DMonitor_INFLICTED_DAMAGE_COMPONENT_KEY 'modDamageMonitorInflictedKey')
(def constant DMonitor_RECEIVD_DAMAGE_COMPONENT_KEY 'modDamageMonitorReceivedKey')
(def constant DMonitor_TARGET_COMPONENT_KEY 'modDamageMonitorTargetKey')
(def constant DMonitor_TEAM_TOTAL_DAMAGE_COMPONENT_KEY 'modDamageMonitorTeamTotalDamageKey')

(def constant DMonitor_PLAYER_INFO_WIDTH 120px)
(def constant DMonitor_SHIP_NAME_WIDTH 90px)
(def constant DMonitor_DAMAGE_WIDTH 50px)
(def constant DMonitor_ROW_HEIGHT 15px)

(def constant DMonitor_ANIM_DURATION 0.6)

(def constant TT_DAMAGEMONITOR_INSTALLED true)

(def constant DMonitor_FONT_COLORS {
	DEFAULT     : "FONT_CLASS_TO_COLOR['$FontColorDefault']",
	BLUE        : "FONT_CLASS_TO_COLOR['$FontColorBuoyancy']",
    DARK_BLUE   : "FONT_CLASS_TO_COLOR['$FontColorTurquoise']",
    GREEN       : "FONT_CLASS_TO_COLOR['$FontColorGreen']",
    LIGHT_GREEN : "FONT_CLASS_TO_COLOR['$FontColorFreeExp']",
    GOLD        : "FONT_CLASS_TO_COLOR['$FontColorGolden']",
	ORANGE      : "FONT_CLASS_TO_COLOR['$FontColorOrange']",
    RED         : "FONT_CLASS_TO_COLOR['$TextColorHUDCriticalPC']",

    ALL         : ['DEFAULT', 'BLUE', 'DARK_BLUE', 'GREEN', 'LIGHT_GREEN', 'GOLD', 'ORANGE', 'RED']
})

